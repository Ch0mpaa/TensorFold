+/// A vector stored as bf16 (common case) or f32 (upstream Qwen3.5 linear_attn
+/// norms): f32 is narrowed to bf16 via RNE to match the dense CUDA gdn_post
+/// kernel ABI. The narrowing is NOT silent: each f32 narrow records the
+/// observed max_abs_err and max_rel_err (bf16 round-trip minus the original)
+/// and writes them to stderr when `TF_NORM_AUDIT=1` is set. On any non-finite
+/// value the audit also tags the tensor and keeps the full run going.
+fn normBf16OrF32(e: *Engine, ck: *core.Checkpoint, comptime fmt: []const u8, args: anytype, n: usize) !u64 {
+    var buf: [160]u8 = undefined;
+    const t = try ck.get(try std.fmt.bufPrint(&buf, fmt, args));
+    if (t.is(.bf16, &.{n})) return upload(e, t.bytes);
+    if (t.is(.f32, &.{n})) {
+        const words = std.mem.bytesAsSlice(u32, t.bytes);
+        const rows = try e.gpa.alloc(u16, n);
+        defer e.gpa.free(rows);
+        var max_abs: f32 = 0.0;
+        var max_rel: f32 = 0.0;
+        var non_finite: usize = 0;
+        for (rows, 0..) |*o, i| {
+            const v: f32 = @bitCast(words[i]);
+            const h = core.bf16_round.bits(v);
+            o.* = h;
+            const back: f32 = @bitCast(@as(u32, h) << 16);
+            if (!std.math.isFinite(v) or !std.math.isFinite(back)) { non_finite += 1; continue; }
+            const ae = @abs(back - v);
+            if (ae > max_abs) max_abs = ae;
+            if (v != 0.0) {
+                const re = @abs((back - v) / v);
+                if (re > max_rel) max_rel = re;
+            }
+        }
+        if (std.c.getenv("TF_NORM_AUDIT") != null) {
+            var msg_buf: [320]u8 = undefined;
+            const name_rendered = try std.fmt.bufPrint(&buf, fmt, args);
+            const msg = try std.fmt.bufPrint(&msg_buf, "tf_norm_audit {s} n={d} max_abs={e} max_rel={e} non_finite={d}\n", .{ name_rendered, n, max_abs, max_rel, non_finite });
+            _ = std.c.write(2, msg.ptr, msg.len);
+        }
+        return upload(e, std.mem.sliceAsBytes(rows));
+    }
+    return error.UnexpectedTensor;
+}
